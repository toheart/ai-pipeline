{
  "name": "@toheart/ai-pipeline",
  "version": "0.3.0",
  "description": "跨 IDE 的 AI 编排 SDK —— Skill 驱动的 AI Agent 流水线编排",
  "type": "module",
  "main": "src/sdk/index.ts",
  "bin": {
    "ai-pipeline": "./bin/ai-pipeline.js"
  },
  "exports": {
    ".": "./src/sdk/index.ts",
    "./engine": "./src/engine/index.ts",
    "./spec": "./spec/runtime-interface.ts"
  },
  "files": [
    "bin/",
    "src/",
    "spec/",
    "scripts/",
    "references/",
    "templates/",
    "examples/",
    "dashboard/dist/",
    "SKILL.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toheart/ai-pipeline.git"
  },
  "scripts": {
    "generate": "tsx bin/ai-pipeline.ts generate",
    "serve": "tsx bin/ai-pipeline.ts serve",
    "status": "tsx bin/ai-pipeline.ts status",
    "build:dashboard": "cd dashboard && npm run build",
    "prebuild": "npm run build:dashboard",
    "test": "tsx --test",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "pipeline",
    "orchestrator",
    "cursor",
    "claude-code",
    "codex",
    "agent",
    "subagent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.8.0"
  }
}
